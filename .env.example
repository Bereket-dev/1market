# Example environment variables for Supabase configuration
# This project reads Supabase values via `--dart-define` at build/run time.
# Replace the placeholder values below with your project's values.

SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=public-anon-key-goes-here
# Optional: OAuth redirect URL registered in Supabase Auth settings
SUPABASE_REDIRECT_URL=io.supabase.koolan://login-callback/

# Usage examples:
# Flutter run (for debug):
# flutter run --dart-define=SUPABASE_URL=https://your-project-id.supabase.co \
#   --dart-define=SUPABASE_ANON_KEY=public-anon-key-goes-here \
#   --dart-define=SUPABASE_REDIRECT_URL=io.supabase.koolan://login-callback/

# Flutter build (release):
# flutter build apk --dart-define=SUPABASE_URL=https://your-project-id.supabase.co \
#   --dart-define=SUPABASE_ANON_KEY=public-anon-key-goes-here

# Note: This file is for reference only. The app reads values from
# `--dart-define` as shown above. If you prefer using a .env loader
# package, adapt `lib/core/config/supabase_config.dart` accordingly.
